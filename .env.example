# ==============================================================================
# VYRA GLOBAL B2B + B2C COMMERCE NETWORK — ENVIRONMENT CONFIGURATION
# BUILD BEYOND BORDERS.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. FRONTEND / BROWSER-SAFE VARIABLES (Accessible via import.meta.env.VITE_*)
# ------------------------------------------------------------------------------
# Supabase Project URL (Dashboard > Settings > API > Project URL)
VITE_SUPABASE_URL="https://your-project.supabase.co"

# Supabase Anonymous Public Key (Browser-safe, strictly enforces Row-Level Security policies)
# NEVER put SUPABASE_SERVICE_ROLE_KEY here. Do NOT use service-role keys in frontend.
VITE_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# Optional Stripe Publishable Key for Client-side Elements
VITE_STRIPE_PUBLISHABLE_KEY="pk_test_..."

# Optional Razorpay Key ID for Client-side Checkout
VITE_RAZORPAY_KEY_ID="rzp_test_..."

# ------------------------------------------------------------------------------
# 2. SERVER-ONLY SECRETS (NEVER exposed to frontend or prefixed with VITE_)
# ------------------------------------------------------------------------------
# Gemini API Key for server-side AI Revenue Agent, Lead Qualification & Assistant
GEMINI_API_KEY="AIzaSy..."

# Server-Side Supabase Service Role Key (ONLY used server-side for admin bypass)
# DO NOT PREFIX WITH VITE_
SUPABASE_SERVICE_ROLE_KEY=""

# Stripe Payment Provider Secret Key
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# Razorpay Payment Provider Secret Key
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""

# Application Host URL
APP_URL="https://your-app-url.run.app"
